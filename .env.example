# Postgres for live data and alerts. Unset = the site reads data/live/*.json.
DATABASE_URL=postgres://postgres@localhost:5433/postgres

# SEC requires a name and email in the User-Agent for EDGAR.
SEC_USER_AGENT="RWABeat your-name@example.com"

# Optional. Comma-separated RPC URLs per chain; defaults are free public endpoints.
RPC_URL_ETHEREUM=
# Optional. Archive RPC for historical getCode during discovery.
ARCHIVE_RPC_URL_ETHEREUM=
# Optional. Verified source fallback when Sourcify has no match, and Etherscan log API.
ETHERSCAN_API_KEY=

# Optional alert publishing.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SITE_URL=https://rwabeat.example

# Optional watcher tuning. PublicNode allows at most ~8 addresses per eth_getLogs.
WATCH_ADDRESS_BATCH=8
WATCH_START_BLOCK=
