# Postgres for live data and alerts. Unset = the site shows no live data or alerts.
DATABASE_URL=postgres://postgres@localhost:5433/postgres

# Optional. Force the catalog source: "files" (Git copy) or "db" (Postgres).
# `next build` always uses files unless this is explicitly "db".
CATALOG_SOURCE=

# SEC requires a name and email in the User-Agent for EDGAR.
SEC_USER_AGENT="RWABeat your-name@example.com"

# Optional. Comma-separated RPC URLs per chain; defaults are free public endpoints.
RPC_URL_ETHEREUM=
# The watcher needs eth_getLogs history when it falls behind; e.g. https://bsc-mainnet.infura.io/v3/<key>
RPC_URL_BSC=
# Optional. Archive RPC for historical getCode during discovery.
ARCHIVE_RPC_URL_ETHEREUM=
# Optional. Verified source fallback when Sourcify has no match, and Etherscan log API.
ETHERSCAN_API_KEY=

# Optional alert publishing.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SITE_URL=https://rwabeat.fyi

# Optional watcher tuning. PublicNode allows at most ~8 addresses per eth_getLogs.
WATCH_ADDRESS_BATCH=8
WATCH_START_BLOCK=

# Optional. PostHog project token (phc_...) for browser analytics; unset = no tracking.
# The project is on PostHog US; the proxy hosts live in next.config.ts.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
